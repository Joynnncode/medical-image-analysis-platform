# Copy this file to .env and adjust values before running `docker compose up`.
# .env itself is gitignored so your real secrets never get committed.

POSTGRES_USER=medimg
POSTGRES_PASSWORD=medimg_dev_password
POSTGRES_DB=medimg

# Generate a real secret with: openssl rand -base64 32
JWT_KEY=dev-only-secret-change-me-please-32chars-min

# --- Segmentation queue ---------------------------------------------------
# How many jobs may be waiting/running before new ones are refused with 503.
MAX_QUEUE_DEPTH=50
# Attempts per job, including the first. Anything that fails them all goes
# to the dead letter queue.
JOB_MAX_ATTEMPTS=3
# Backoff (seconds) before each retry. This is a floor - the worker's
# scheduler picks delayed retries up on its own tick, so very short values
# round up to roughly that tick.
JOB_RETRY_INTERVALS=10,30
# A job still running after this is killed and retried.
JOB_TIMEOUT_SECONDS=1800
